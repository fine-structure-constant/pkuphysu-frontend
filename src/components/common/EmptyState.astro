---
interface Props { title: string; description: string; tone?: "default" | "error"; }
const { title, description, tone = "default" } = Astro.props;
---
<div class:list={["empty-state", { "empty-state--error": tone === "error" }]}>
  <span class="empty-state__mark" aria-hidden="true">{tone === "error" ? "!" : "○"}</span>
  <div><strong>{title}</strong><p>{description}</p></div>
</div>
